export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="x"

# vim mode
bindkey -v

# disable annoying message to update
DISABLE_AUTO_UPDATE=true
DISABLE_UPDATE_PROMPT=true
zstyle ':omz:update' mode disabled

plugins=(
    git
    zsh-autosuggestions
    zsh-syntax-highlighting
    vi-mode
)

# imports
source $ZSH/oh-my-zsh.sh

