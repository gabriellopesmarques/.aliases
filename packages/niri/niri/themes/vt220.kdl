// Theme: vt220 (amber terminal)
// Cores derivadas de i3/i3/themes/vt220.theme e rofi/vt220.rasi
layout {
    background-color "#000000"

    focus-ring {
        off
    }

    border {
        on
        width 2
        active-color "#FFA800"
        inactive-color "#8A5F0C"
        urgent-color "#FFA800"
    }
}

// vt220: cantos retos (sem arredondamento)
window-rule {
    geometry-corner-radius 0
    clip-to-geometry true
}
