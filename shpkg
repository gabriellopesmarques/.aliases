#!/bin/bash

###########################
##     shpkg v2.1.0      ##
###########################

set -euo pipefail

SHPKG_ROOT="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd)"
SHPKG_BIN="/usr/local/bin/shpkg"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/shpkg"
STATE_FILE="$STATE_DIR/installed"

is_installed() {
  [[ -f "$STATE_FILE" ]] && grep -qxF -- "$1" "$STATE_FILE"
}

record_install() {
  mkdir -p "$STATE_DIR"
  if ! is_installed "$1"; then
    printf '%s\n' "$1" >>"$STATE_FILE"
  fi
}

valid_name() {
  [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]
}

pkg_type() {
  local name="$1"

  if [[ -f "$SHPKG_ROOT/packages/$name/install.sh" ]]; then
    printf 'package'
  elif [[ -f "$SHPKG_ROOT/groups/$name/install.sh" ]]; then
    printf 'group'
  else
    return 1
  fi
}

pkg_dir() {
  local name="$1"
  local type="$2"

  printf '%s/%ss/%s' "$SHPKG_ROOT" "$type" "$name"
}

pkg_description() {
  local dir="$1"
  local readme="$dir/README.md"
  local line

  if [[ ! -f "$readme" ]]; then
    printf -- '-'
    return
  fi

  while IFS= read -r line; do
    line="${line#"${line%%[![:space:]]*}"}"
    [[ -z "$line" ]] && continue
    while [[ "$line" == \#* ]]; do
      line="${line#\#}"
    done
    line="${line# }"
    if [[ -n "$line" ]]; then
      printf '%s' "$line"
      return
    fi
  done <"$readme"

  printf -- '-'
}

list_section() {
  local type="$1"
  local title="$2"
  local base="$SHPKG_ROOT/${type}s"
  local dir
  local name
  local status
  local description

  printf '\n%s:\n' "$title"
  printf '  %-20s %-11s %s\n' "NAME" "STATUS" "DESCRIPTION"

  shopt -s nullglob
  for dir in "$base"/*/; do
    [[ -f "$dir/install.sh" ]] || continue
    name="$(basename -- "$dir")"
    status="available"
    if is_installed "$name"; then
      status="installed"
    fi
    description="$(pkg_description "$dir")"
    printf '  %-20s %-11s %s\n' "$name" "$status" "$description"
  done
  shopt -u nullglob
}

list_packages() {
  list_section "package" "Packages"
  list_section "group" "Groups"
  printf '\n'
}

info_package() {
  local name="$1"
  local type
  local dir

  if ! valid_name "$name"; then
    printf "error: invalid package name '%s'\n" "$name" >&2
    return 1
  fi

  if ! type="$(pkg_type "$name")"; then
    printf "error: unknown package '%s'\n" "$name" >&2
    printf "run 'shpkg list' to see available packages\n" >&2
    return 1
  fi

  dir="$(pkg_dir "$name" "$type")"

  printf 'name:         %s\n' "$name"
  printf 'type:         %s\n' "$type"
  printf 'description:  %s\n' "$(pkg_description "$dir")"
  printf 'directory:    %s\n' "$dir"
  if [[ -f "$dir/uninstall.sh" ]]; then
    printf 'uninstall:    available\n'
  else
    printf 'uninstall:    not available\n'
  fi
  if [[ -f "$dir/README.md" ]]; then
    printf 'readme:       %s/README.md\n' "$dir"
  else
    printf 'readme:       not available\n'
  fi
  if is_installed "$name"; then
    printf 'status:       installed\n'
  else
    printf 'status:       available\n'
  fi
}

install_pkg() {
  local name="$1"
  local type
  local dir
  local script

  if ! valid_name "$name"; then
    printf "error: invalid package name '%s'\n" "$name" >&2
    return 1
  fi

  if ! type="$(pkg_type "$name")"; then
    printf "error: unknown package '%s'\n" "$name" >&2
    printf "run 'shpkg list' to see available packages\n" >&2
    return 1
  fi

  dir="$(pkg_dir "$name" "$type")"
  script="$dir/install.sh"

  if [[ " ${SHPKG_STACK:-} " == *" $name "* ]]; then
    printf "error: dependency cycle involving '%s'\n" "$name" >&2
    return 1
  fi

  if [[ "$name" != "shpkg" ]] && is_installed "$name"; then
    printf '==> %s already installed\n' "$name"
    return 0
  fi

  printf '==> installing %s (%s)\n' "$name" "$type"

  (
    set -eE
    trap 'printf "error: failed to install %s\n" "$name" >&2' ERR
    export SHPKG_ROOT
    export SHPKG_BIN
    export SHPKG_NAME="$name"
    export SHPKG_TYPE="$type"
    export SHPKG_PKG_DIR="$dir"
    export SHPKG_STACK="${SHPKG_STACK:+$SHPKG_STACK }$name"
    bash -e "$script"
  )

  record_install "$name"
}

usage() {
  cat <<'EOF'
shpkg v2.1.0 - package manager for the ~/.aliases repository

Usage:
  shpkg install <pkg> [<pkg>...]   Install one or more packages or groups
  shpkg list                       List available packages and groups
  shpkg info <pkg>                 Show package details
  shpkg --help                     Show this help message

Packages live in packages/<name>/install.sh and groups in
groups/<name>/install.sh.

Bootstrap shpkg itself:
  cd ~/.aliases
  ./shpkg install shpkg

After bootstrap, run shpkg from any directory:
  shpkg install dnsglobe
EOF
}

main() {
  local command="${1:-}"

  shift || true

  case "$command" in
  install)
    if [[ $# -eq 0 ]]; then
      printf 'error: install requires at least one package\n' >&2
      usage >&2
      return 1
    fi
    local name
    for name in "$@"; do
      install_pkg "$name"
    done
    ;;
  list)
    if [[ $# -ne 0 ]]; then
      printf 'error: list does not accept arguments\n' >&2
      return 1
    fi
    list_packages
    ;;
  info)
    if [[ $# -ne 1 ]]; then
      printf 'error: info requires exactly one package\n' >&2
      return 1
    fi
    info_package "$1"
    ;;
  help | -h | --help | "")
    usage
    ;;
  *)
    printf "error: unknown command '%s'\n" "$command" >&2
    usage >&2
    return 1
    ;;
  esac
}

main "$@"
