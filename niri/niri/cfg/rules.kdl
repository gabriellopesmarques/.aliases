    // Cantos arredondados de janelas são definidos POR TEMA em themes/<tema>.kdl
    // (window-rule geometry-corner-radius). Temas "retos" usam radius 0.

     // if you use steam you will probably like these
    window-rule {
        match app-id="steam"
        exclude title=r#"^[Ss]team$"#
        open-floating true
    }

    window-rule {
       match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
       default-floating-position x=10 y=10 relative-to="bottom-right"
       open-focused false
    }
