{
    "layer": "top",
    "modules-left": ["niri/workspaces", "niri/mode"],
    "modules-center": ["niri/window"],
    "modules-right": ["clock"],
    "niri/window": {
        "max-length": 50
    },
    "clock": {
		"tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
		"format": "{:%F %T}",
		"format-alt": "{:%F %T}",
		"interval": 1
    }
}
